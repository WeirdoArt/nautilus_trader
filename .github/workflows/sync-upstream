name: Sync Upstream Fork
# 定时执行 + 手动按钮触发
on:
  schedule:
    # cron UTC时间，示例：每天凌晨2点执行
    - cron: '0 2 * * *'
    # 允许手动点Run workflow触发
  workflow_dispatch:

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: 检出当前fork仓库完整代码
        uses: actions/checkout@v4
        with:
          fetch-depth: 0 # 获取完整提交历史，rebase/merge不报错

      - name: 配置Git用户
        run: |
          git config --global user.name "塞北交易猿"
          git config --global user.email "35830502@qq.com"

      - name: 添加上游源仓库
        run: |
          # 替换为你的原始上游仓库地址
          git remote add upstream https://github.com/nautechsystems/nautilus_trader.git
          git remote -v

      - name: 拉取上游全部更新
        run: git fetch upstream

      - name: 切换到主分支并rebase上游（推荐，无多余合并提交）
        run: |
          git checkout main
          # rebase上游代码，保持提交线性
          git rebase upstream/main
          # 若改用merge：git merge upstream/main

      - name: 推送同步后的代码到自己fork仓库
        run: git push origin main --force-with-lease
